/* ═══════════════════════════════════════════════════════════
   病理裁剪工具 — 深色主题 v3 · 临床仪器面板
   层级：window → panel → raised → surface → line
   强调：系统蓝 #0A84FF · H&E 玫瑰 #FF4D6D（ROI/区块刻度）
   圆角：4 / 6 / 8 / 10 / 12 · 焦点环 2px
   ═══════════════════════════════════════════════════════════ */

/* ── 全局 ── */
QMainWindow, QDialog, QWidget {
    background-color: #0F0F11;
    color: #F0F0F4;
    font-family: "Segoe UI", "SF Pro Text", "SF Pro Display",
                 "Microsoft YaHei UI", "PingFang SC", "Helvetica Neue",
                 sans-serif;
    font-size: 13px;
}
QWidget:disabled {
    color: rgba(240, 240, 244, 0.34);
}
QLabel {
    background: transparent;
    border: none;
}

/* ── 侧栏 ── */
#sidePanel {
    background: #141417;
    border: none;
}

/* ── 分割条 ── */
QSplitter::handle {
    background: #2A2A31;
    width: 1px;
    margin: 0;
}
QSplitter::handle:hover {
    background: #0A84FF;
}
QSplitter::handle:pressed {
    background: #64D2FF;
}

/* ══════════════════════════════════════════
   菜单
   ══════════════════════════════════════════ */
QMenuBar {
    background: #1A1A1E;
    color: rgba(240, 240, 244, 0.90);
    border-bottom: 1px solid #2A2A31;
    padding: 2px 10px;
    font-size: 13px;
    font-weight: 500;
}
QMenuBar::item {
    padding: 5px 11px;
    border-radius: 6px;
    background: transparent;
}
QMenuBar::item:selected {
    background: rgba(118, 118, 128, 0.34);
}
QMenuBar::item:pressed {
    background: rgba(10, 132, 255, 0.22);
}

QMenu {
    background: #1F1F24;
    border: 1px solid #33333B;
    border-radius: 10px;
    padding: 6px;
    margin-top: 2px;
}
QMenu::item {
    padding: 7px 32px 7px 16px;
    border-radius: 6px;
    color: rgba(240, 240, 244, 0.90);
    background: transparent;
}
QMenu::item:selected {
    background: #0A84FF;
    color: #FFFFFF;
}
QMenu::item:disabled {
    color: rgba(240, 240, 244, 0.30);
}
QMenu::separator {
    height: 1px;
    background: #33333B;
    margin: 5px 12px;
}

/* ══════════════════════════════════════════
   顶部工具栏
   ══════════════════════════════════════════ */
#topToolbar {
    background: linear-gradient(to bottom, #1E1E23, #1A1A1F);
    border-bottom: 1px solid #2E2E36;
    padding: 0 10px;
}
#topToolbar QLabel {
    color: rgba(240, 240, 244, 0.58);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    background: transparent;
    border: none;
    padding: 0 3px;
    min-height: 26px;
    max-height: 32px;
}

/* 工具栏控件 */
#topToolbar QComboBox,
#topToolbar QSpinBox {
    background: #26262C;
    color: #F0F0F4;
    border: 1px solid #34343C;
    border-radius: 6px;
    padding: 2px 22px 2px 8px;
    font-size: 12px;
    font-weight: 500;
    min-height: 24px;
    max-height: 28px;
    min-width: 52px;
}
#topToolbar QComboBox:hover,
#topToolbar QSpinBox:hover {
    background: #2C2C33;
    border-color: #4A4A54;
}
#topToolbar QComboBox:focus,
#topToolbar QSpinBox:focus {
    border: 2px solid #0A84FF;
    padding: 1px 21px 1px 7px;
    background: #26262C;
}
#topToolbar QComboBox::drop-down {
    background: transparent;
    border: none;
    width: 18px;
}
#topToolbar QComboBox::down-arrow {
    image: url(__THEME_DIR__/arrow_down.png);
    width: 12px;
    height: 12px;
}
#topToolbar QComboBox QAbstractItemView {
    background: #1F1F24;
    border: 1px solid #33333B;
    border-radius: 10px;
    padding: 5px;
    color: #F0F0F4;
    outline: none;
    selection-background-color: #0A84FF;
}
#topToolbar QComboBox QAbstractItemView::item {
    padding: 6px 14px;
    border-radius: 6px;
    min-height: 26px;
}
#topToolbar QComboBox QAbstractItemView::item:selected {
    background: #0A84FF;
    color: #FFFFFF;
}
#topToolbar QComboBox QAbstractItemView::item:hover:!selected {
    background: rgba(118, 118, 128, 0.22);
}
#topToolbar QSpinBox::up-button,
#topToolbar QSpinBox::down-button {
    background: transparent;
    border: none;
    border-radius: 4px;
    width: 16px;
    height: 11px;
    right: 2px;
}
#topToolbar QSpinBox::up-button:hover,
#topToolbar QSpinBox::down-button:hover {
    background: rgba(118, 118, 128, 0.32);
}
#topToolbar QSpinBox::up-arrow {
    image: url(__THEME_DIR__/arrow_up.png);
    width: 10px;
    height: 10px;
}
#topToolbar QSpinBox::down-arrow {
    image: url(__THEME_DIR__/arrow_down.png);
    width: 10px;
    height: 10px;
}

/* 工具栏滑块 */
#topToolbar QSlider::groove:horizontal {
    background: #32323A;
    height: 4px;
    border-radius: 2px;
}
#topToolbar QSlider::handle:horizontal {
    background: #FFFFFF;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
    border: 0.5px solid rgba(0, 0, 0, 0.14);
}
#topToolbar QSlider::handle:horizontal:hover {
    background: #F5F5F7;
    border-color: rgba(10, 132, 255, 0.55);
}
#topToolbar QSlider::handle:horizontal:pressed {
    background: #E8E8ED;
    border-color: #0A84FF;
}
#topToolbar QSlider::sub-page:horizontal {
    background: #0A84FF;
    border-radius: 2px;
}

/* ══════════════════════════════════════════
   状态胶囊
   ══════════════════════════════════════════ */
#statusLabel {
    color: #E8E8EE;
    font-size: 12px;
    font-weight: 600;
    background: #26262C;
    border-radius: 999px;
    padding: 4px 14px;
    border: 1px solid #34343C;
}

/* ROI 信息条 */
#roiInfoLabel {
    color: rgba(240, 240, 244, 0.72);
    font-size: 11px;
    font-weight: 500;
    background: rgba(10, 132, 255, 0.08);
    border: 1px solid rgba(10, 132, 255, 0.18);
    border-radius: 8px;
    padding: 6px 10px;
    line-height: 1.35;
}

/* ══════════════════════════════════════════
   预设
   ══════════════════════════════════════════ */
#presetCb {
    min-width: 90px;
    font-weight: 600;
}
#savePresetBtn {
    background: #26262C;
    border: 1px solid #34343C;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 10px;
    color: #E8E8EE;
    min-height: 24px;
    max-height: 28px;
}
#savePresetBtn:hover {
    background: #2E2E35;
    border-color: #4A4A54;
    color: #F0F0F4;
}
#savePresetBtn:pressed {
    background: #34343C;
}
#savePresetBtn:focus {
    border: 2px solid #0A84FF;
    padding: 1px 9px;
}

/* ══════════════════════════════════════════
   按钮体系
   ══════════════════════════════════════════ */
QPushButton {
    background: #26262C;
    color: #F0F0F4;
    border: 1px solid #34343C;
    border-radius: 6px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 500;
    min-height: 24px;
    max-height: 30px;
}
QPushButton:hover {
    background: #2E2E35;
    border-color: #4A4A54;
    color: #FFFFFF;
}
QPushButton:pressed {
    background: #1F1F24;
    border-color: #0A84FF;
}
QPushButton:checked {
    background: rgba(10, 132, 255, 0.20);
    border-color: #0A84FF;
    color: #64D2FF;
}
QPushButton:checked:hover {
    background: rgba(10, 132, 255, 0.28);
}
QPushButton:disabled {
    background: #1A1A1E;
    color: rgba(240, 240, 244, 0.32);
    border-color: #25252B;
}
QPushButton:focus {
    border: 2px solid #0A84FF;
    padding: 4px 11px;
    outline: none;
}
QPushButton:focus:disabled {
    border-color: #25252B;
    padding: 5px 12px;
}

/* 分析工具行按钮 */
#toolActionBtn {
    background: #1F1F24;
    border: 1px solid #2E2E36;
    border-radius: 8px;
    padding: 7px 12px;
    font-size: 12px;
    font-weight: 500;
    text-align: left;
    min-height: 26px;
}
#toolActionBtn:hover {
    background: rgba(10, 132, 255, 0.12);
    border-color: rgba(10, 132, 255, 0.40);
    color: #64D2FF;
}
#toolActionBtn:pressed {
    background: rgba(10, 132, 255, 0.20);
    border-color: #0A84FF;
}
#toolActionBtn:focus {
    border: 2px solid #0A84FF;
    padding: 6px 11px;
}
#toolActionBtn:disabled {
    background: #17171A;
    border-color: #25252B;
    color: rgba(240, 240, 244, 0.30);
}

/* ROI 模式开关 */
#roiBtn {
    padding: 5px 14px;
    font-weight: 600;
    background: rgba(10, 132, 255, 0.14);
    border-color: rgba(10, 132, 255, 0.40);
    color: #64D2FF;
}
#roiBtn:hover {
    background: rgba(10, 132, 255, 0.22);
    border-color: rgba(10, 132, 255, 0.60);
}
#roiBtn:pressed {
    background: rgba(10, 132, 255, 0.30);
}
#roiBtn:checked {
    background: #0A84FF;
    color: #FFFFFF;
    border-color: #0A84FF;
}
#roiBtn:checked:hover {
    background: #0974E0;
    border-color: #0974E0;
}
#roiBtn:checked:pressed {
    background: #075FBC;
}

/* 主操作 */
#primaryBtn {
    background: #0A84FF;
    color: #FFFFFF;
    border: none;
    font-weight: 600;
    padding: 5px 16px;
    border-radius: 6px;
    min-height: 26px;
}
#primaryBtn:hover {
    background: #0974E0;
}
#primaryBtn:pressed {
    background: #075FBC;
}
#primaryBtn:disabled {
    background: #1F1F24;
    color: rgba(240, 240, 244, 0.32);
    border: 1px solid #25252B;
}
#primaryBtn:focus {
    border: 2px solid #64D2FF;
    outline: none;
}

/* 导出 */
#exportBtn {
    background: #30D158;
    color: #06140A;
    border: none;
    font-weight: 700;
    padding: 5px 14px;
    border-radius: 6px;
    min-height: 26px;
}
#exportBtn:hover {
    background: #3BE066;
}
#exportBtn:pressed {
    background: #28A34A;
}
#exportBtn:disabled {
    background: #1F1F24;
    color: rgba(240, 240, 244, 0.32);
    border: 1px solid #25252B;
}
#exportBtn:focus {
    border: 2px solid #A7F3C0;
    outline: none;
}

/* 输出目录 · 幽灵按钮 */
#dirBtn {
    background: transparent;
    border: 1px solid #3A3A42;
    color: rgba(240, 240, 244, 0.72);
    padding: 5px 12px;
    font-weight: 500;
}
#dirBtn:hover {
    border-color: #0A84FF;
    color: #FFFFFF;
    background: rgba(10, 132, 255, 0.10);
}
#dirBtn:pressed {
    background: rgba(10, 132, 255, 0.18);
}
#dirBtn:focus {
    border: 2px solid #0A84FF;
    padding: 4px 11px;
}

/* 中断 */
#cancelBtn {
    background: #FF453A;
    border: none;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 700;
    border-radius: 999px;
    min-width: 22px;
    min-height: 22px;
    max-width: 22px;
    max-height: 22px;
    padding: 0;
}
#cancelBtn:hover {
    background: #FF6961;
}
#cancelBtn:pressed {
    background: #D70015;
}

/* 危险 · 软填充 */
#dangerBtn {
    background: rgba(255, 69, 58, 0.10);
    color: #FF6961;
    border: 1px solid rgba(255, 69, 58, 0.28);
    font-weight: 600;
    padding: 5px 12px;
}
#dangerBtn:hover {
    background: rgba(255, 69, 58, 0.22);
    border-color: rgba(255, 69, 58, 0.55);
    color: #FF8A80;
}
#dangerBtn:pressed {
    background: #FF453A;
    color: #FFFFFF;
    border-color: #FF453A;
}
#dangerBtn:focus {
    border: 2px solid #FF6961;
    padding: 4px 11px;
}
#dangerBtn:disabled {
    background: rgba(255, 69, 58, 0.05);
    color: rgba(255, 105, 97, 0.35);
    border-color: rgba(255, 69, 58, 0.12);
}

/* 预览关闭 */
#previewCloseBtn {
    background: transparent;
    color: #8E8E96;
    border: none;
    border-radius: 14px;
    font-size: 15px;
    font-weight: 500;
    padding: 0;
    min-width: 28px;
    min-height: 28px;
    max-width: 28px;
    max-height: 28px;
}
#previewCloseBtn:hover {
    background: rgba(118, 118, 128, 0.36);
    color: #FFFFFF;
}
#previewCloseBtn:pressed {
    background: rgba(118, 118, 128, 0.50);
}

/* 预览导出 */
#previewExportBtn {
    background: #0A84FF;
    color: #FFFFFF;
    border: none;
    font-weight: 600;
    padding: 5px 14px;
    border-radius: 6px;
    min-height: 26px;
}
#previewExportBtn:hover {
    background: #0974E0;
}
#previewExportBtn:pressed {
    background: #075FBC;
}
#previewExportBtn:disabled {
    background: #1F1F24;
    color: rgba(240, 240, 244, 0.32);
    border: 1px solid #25252B;
}

/* ══════════════════════════════════════════
   列表
   ══════════════════════════════════════════ */
QListWidget {
    background: #1A1A1F;
    border: 1px solid #2A2A31;
    border-radius: 10px;
    padding: 4px;
    outline: none;
    color: #F0F0F4;
    font-size: 12px;
    alternate-background-color: #1E1E23;
}
QListWidget::item {
    padding: 8px 12px 8px 14px;
    border-radius: 6px;
    margin: 1px 0;
    border-left: 3px solid transparent;
    min-height: 20px;
}
QListWidget::item:selected {
    background: rgba(10, 132, 255, 0.24);
    color: #FFFFFF;
    border-left: 3px solid #0A84FF;
}
QListWidget::item:hover:!selected {
    background: rgba(118, 118, 128, 0.18);
    border-left: 3px solid rgba(118, 118, 128, 0.45);
}
QListWidget::item:selected:hover {
    background: rgba(10, 132, 255, 0.32);
}
QListWidget::item:disabled {
    color: rgba(240, 240, 244, 0.30);
    background: transparent;
}

/* ROI 列表：选中用 H&E 玫瑰（与画布标注同语言） */
#roiList::item:selected,
QListWidget#roiList::item:selected {
    background: rgba(255, 77, 109, 0.22);
    border-left: 3px solid #FF4D6D;
}
#roiList::item:selected:hover,
QListWidget#roiList::item:selected:hover {
    background: rgba(255, 77, 109, 0.30);
}
#roiList::item:hover:!selected,
QListWidget#roiList::item:hover:!selected {
    background: rgba(255, 77, 109, 0.10);
    border-left: 3px solid rgba(255, 77, 109, 0.40);
}

/* ══════════════════════════════════════════
   区块标题 — H&E 玫瑰刻度
   ══════════════════════════════════════════ */
#sectionHeader {
    color: rgba(240, 240, 244, 0.55);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.10em;
    padding: 12px 0 6px 10px;
    background: transparent;
    border: none;
    border-left: 2px solid #FF4D6D;
}

/* ══════════════════════════════════════════
   导航 / 标签图
   ══════════════════════════════════════════ */
#navWidget {
    background: #1A1A1F;
    border: 1px solid #2A2A31;
    border-radius: 10px;
}
#labelImage {
    background: #121215;
    border: 1px dashed #33333B;
    border-radius: 8px;
    color: #6E6E78;
    font-size: 12px;
}

/* 分析工具组 */
#analysisGroup {
    background: #1A1A1F;
    border: 1px solid #2A2A31;
    border-radius: 10px;
    padding: 8px;
}

/* ══════════════════════════════════════════
   表单
   ══════════════════════════════════════════ */
QGroupBox {
    color: rgba(240, 240, 244, 0.55);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-top: 8px;
    padding-top: 4px;
    border: none;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 0;
    padding: 0 4px;
}
QFormLayout QLabel {
    color: rgba(240, 240, 244, 0.68);
    font-size: 12px;
    font-weight: 500;
}
QFormLayout QSpinBox,
QFormLayout QDoubleSpinBox {
    background: #26262C;
    color: #F0F0F4;
    border: 1px solid #34343C;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 12px;
    font-weight: 500;
    min-height: 24px;
    min-width: 76px;
}
QFormLayout QSpinBox:hover,
QFormLayout QDoubleSpinBox:hover {
    background: #2C2C33;
    border-color: #4A4A54;
}
QFormLayout QSpinBox:focus,
QFormLayout QDoubleSpinBox:focus {
    border: 2px solid #0A84FF;
    padding: 3px 7px;
}
QFormLayout QSpinBox:disabled,
QFormLayout QDoubleSpinBox:disabled {
    background: #1A1A1E;
    color: rgba(240, 240, 244, 0.32);
    border-color: #25252B;
}

/* ══════════════════════════════════════════
   进度
   ══════════════════════════════════════════ */
#exportProgress {
    background: #26262C;
    border: 1px solid #34343C;
    border-radius: 999px;
    text-align: center;
    color: #FFFFFF;
    font-size: 10px;
    font-weight: 700;
    min-height: 18px;
    max-height: 20px;
    min-width: 160px;
}
#exportProgress::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0A84FF, stop:0.55 #32ADE6, stop:1 #64D2FF);
    border-radius: 999px;
}

QProgressBar {
    background: #26262C;
    border: 1px solid #34343C;
    border-radius: 6px;
    text-align: center;
    color: #F0F0F4;
    font-size: 11px;
    font-weight: 600;
    min-height: 18px;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0A84FF, stop:1 #64D2FF);
    border-radius: 5px;
}

QProgressDialog {
    background: #1F1F24;
    border: 1px solid #33333B;
    border-radius: 12px;
    padding: 22px;
    color: #F0F0F4;
}

/* ══════════════════════════════════════════
   对话框
   ══════════════════════════════════════════ */
QDialog {
    background: #1A1A1F;
}
QDialog QLabel {
    color: #F0F0F4;
    font-size: 13px;
}
QDialog QPushButton {
    min-width: 84px;
    min-height: 30px;
}
QMessageBox {
    background: #1F1F24;
    color: #F0F0F4;
}
QMessageBox QLabel {
    color: #F0F0F4;
    font-size: 13px;
}
QMessageBox QPushButton {
    min-width: 88px;
    min-height: 30px;
}
QInputDialog {
    background: #1F1F24;
}
QInputDialog QLabel {
    color: #F0F0F4;
    font-size: 13px;
}
QInputDialog QLineEdit {
    background: #26262C;
    color: #F0F0F4;
    border: 1px solid #34343C;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 13px;
    min-height: 26px;
}
QInputDialog QLineEdit:focus {
    border: 2px solid #0A84FF;
    padding: 5px 11px;
}

QDialogButtonBox QPushButton {
    min-width: 80px;
    min-height: 30px;
}
QDialogButtonBox QPushButton[role="accept"],
QDialogButtonBox QPushButton default {
    background: #0A84FF;
    color: #FFFFFF;
    border: none;
    font-weight: 600;
}
QDialogButtonBox QPushButton[role="accept"]:hover,
QDialogButtonBox QPushButton default:hover {
    background: #0974E0;
}

/* ══════════════════════════════════════════
   行输入 / 下拉 / 数字 — 通用
   ══════════════════════════════════════════ */
QLineEdit, QPlainTextEdit, QTextEdit, QTextBrowser {
    background: #26262C;
    color: #F0F0F4;
    border: 1px solid #34343C;
    border-radius: 6px;
    padding: 5px 12px;
    font-size: 12px;
    min-height: 24px;
    selection-background-color: #0A84FF;
    selection-color: #FFFFFF;
}
QPlainTextEdit, QTextEdit, QTextBrowser {
    min-height: 60px;
    padding: 8px 10px;
    line-height: 1.4;
}
QLineEdit:hover, QPlainTextEdit:hover, QTextEdit:hover, QTextBrowser:hover {
    background: #2A2A30;
    border-color: #4A4A54;
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QTextBrowser:focus {
    border: 2px solid #0A84FF;
    padding: 4px 11px;
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QTextBrowser:focus {
    padding-top: 4px;
}
QLineEdit:disabled, QPlainTextEdit:disabled, QTextEdit:disabled, QTextBrowser:disabled {
    background: #1A1A1E;
    color: rgba(240, 240, 244, 0.32);
    border-color: #25252B;
}
QLineEdit[readOnly="true"] {
    background: #1F1F24;
    color: rgba(240, 240, 244, 0.75);
}

QComboBox {
    background: #26262C;
    color: #F0F0F4;
    border: 1px solid #34343C;
    border-radius: 6px;
    padding: 4px 22px 4px 10px;
    font-size: 12px;
    min-height: 26px;
}
QComboBox:hover {
    background: #2C2C33;
    border-color: #4A4A54;
}
QComboBox:focus {
    border: 2px solid #0A84FF;
    padding: 3px 21px 3px 9px;
    outline: none;
}
QComboBox:disabled {
    background: #1A1A1E;
    color: rgba(240, 240, 244, 0.32);
    border-color: #25252B;
}
QComboBox::drop-down {
    background: transparent;
    border: none;
    width: 20px;
}
QComboBox::down-arrow {
    image: url(__THEME_DIR__/arrow_down.png);
    width: 12px;
    height: 12px;
}
QComboBox QAbstractItemView {
    background: #1F1F24;
    border: 1px solid #33333B;
    border-radius: 10px;
    padding: 5px;
    color: #F0F0F4;
    outline: none;
    selection-background-color: #0A84FF;
}
QComboBox QAbstractItemView::item {
    padding: 7px 14px;
    border-radius: 6px;
    min-height: 28px;
}
QComboBox QAbstractItemView::item:selected {
    background: #0A84FF;
    color: #FFFFFF;
}
QComboBox QAbstractItemView::item:hover:!selected {
    background: rgba(118, 118, 128, 0.22);
}

QSpinBox, QDoubleSpinBox {
    background: #26262C;
    color: #F0F0F4;
    border: 1px solid #34343C;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 12px;
    min-height: 26px;
}
QSpinBox:hover, QDoubleSpinBox:hover {
    background: #2C2C33;
    border-color: #4A4A54;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #0A84FF;
    padding: 3px 7px;
}
QSpinBox:disabled, QDoubleSpinBox:disabled {
    background: #1A1A1E;
    color: rgba(240, 240, 244, 0.32);
    border-color: #25252B;
}
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background: transparent;
    border: none;
    border-radius: 4px;
    width: 18px;
    height: 12px;
    right: 2px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover {
    background: rgba(118, 118, 128, 0.32);
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(__THEME_DIR__/arrow_up.png);
    width: 10px;
    height: 10px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(__THEME_DIR__/arrow_down.png);
    width: 10px;
    height: 10px;
}

/* ══════════════════════════════════════════
   滑块
   ══════════════════════════════════════════ */
QSlider::groove:horizontal {
    background: #32323A;
    height: 4px;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #FFFFFF;
    width: 18px;
    height: 18px;
    margin: -7px 0;
    border-radius: 9px;
    border: 0.5px solid rgba(0, 0, 0, 0.15);
}
QSlider::handle:horizontal:hover {
    background: #F5F5F7;
    border-color: rgba(10, 132, 255, 0.55);
}
QSlider::handle:horizontal:pressed {
    background: #E8E8ED;
    border-color: #0A84FF;
}
QSlider::sub-page:horizontal {
    background: #0A84FF;
    border-radius: 2px;
}
QSlider::add-page:horizontal {
    background: #32323A;
    border-radius: 2px;
}
QSlider:disabled::groove:horizontal {
    background: #1F1F24;
}
QSlider:disabled::handle:horizontal {
    background: #3A3A42;
}

/* ══════════════════════════════════════════
   复选 / 单选
   ══════════════════════════════════════════ */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: #F0F0F4;
    font-size: 13px;
    background: transparent;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1.5px solid #4A4A54;
    background: #1F1F24;
}
QRadioButton::indicator {
    border-radius: 8px;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #0A84FF;
    background: rgba(10, 132, 255, 0.10);
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #0A84FF;
    border-color: #0A84FF;
}
QCheckBox::indicator:checked:hover, QRadioButton::indicator:checked:hover {
    background: #0974E0;
    border-color: #0974E0;
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    background: #17171A;
    border-color: #25252B;
}
QCheckBox:disabled, QRadioButton:disabled {
    color: rgba(240, 240, 244, 0.32);
}

/* ══════════════════════════════════════════
   表格（导出队列 / 元数据 / 评分）
   ══════════════════════════════════════════ */
QTableWidget, QTableView {
    background: #1A1A1F;
    alternate-background-color: #1E1E23;
    border: 1px solid #2A2A31;
    border-radius: 10px;
    gridline-color: #2A2A31;
    color: #F0F0F4;
    font-size: 12px;
    selection-background-color: rgba(10, 132, 255, 0.24);
    selection-color: #FFFFFF;
    outline: none;
}
QTableWidget::item, QTableView::item {
    padding: 6px 10px;
    border: none;
}
QTableWidget::item:selected, QTableView::item:selected {
    background: rgba(10, 132, 255, 0.24);
    color: #FFFFFF;
}
QHeaderView {
    background: #1F1F24;
    border: none;
}
QHeaderView::section {
    background: #1F1F24;
    color: rgba(240, 240, 244, 0.70);
    border: none;
    border-bottom: 1px solid #2E2E36;
    border-right: 1px solid #2A2A31;
    padding: 8px 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
}
QHeaderView::section:hover {
    background: #26262C;
    color: #F0F0F4;
}
QHeaderView::section:pressed {
    background: rgba(10, 132, 255, 0.16);
}
QTableCornerButton::section {
    background: #1F1F24;
    border: none;
}

/* ══════════════════════════════════════════
   标签页
   ══════════════════════════════════════════ */
QTabWidget::pane {
    background: #16161A;
    border: 1px solid #2A2A31;
    border-radius: 10px;
    top: -1px;
}
QTabBar::tab {
    background: #1A1A1F;
    color: rgba(240, 240, 244, 0.58);
    border: 1px solid #2A2A31;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 18px;
    font-size: 12px;
    font-weight: 500;
    min-height: 28px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background: #16161A;
    color: #F0F0F4;
    border-bottom: 2px solid #0A84FF;
    font-weight: 600;
}
QTabBar::tab:hover:!selected {
    background: #222228;
    color: #F0F0F4;
}
QTabBar::tab:focus {
    border: 2px solid #0A84FF;
}

/* ══════════════════════════════════════════
   滚动条
   ══════════════════════════════════════════ */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    border: none;
    margin: 4px 0;
}
QScrollBar::handle:vertical {
    background: rgba(118, 118, 128, 0.40);
    border-radius: 5px;
    min-height: 36px;
    margin: 1px;
    border: 2px solid transparent;
    background-clip: padding-box;
}
QScrollBar::handle:vertical:hover {
    background: rgba(118, 118, 128, 0.65);
    background-clip: padding-box;
    border: 2px solid transparent;
}
QScrollBar::handle:vertical:pressed {
    background: rgba(118, 118, 128, 0.85);
    background-clip: padding-box;
    border: 2px solid transparent;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    border: none;
    margin: 0 4px;
}
QScrollBar::handle:horizontal {
    background: rgba(118, 118, 128, 0.40);
    border-radius: 5px;
    min-width: 36px;
    margin: 1px;
    border: 2px solid transparent;
    background-clip: padding-box;
}
QScrollBar::handle:horizontal:hover {
    background: rgba(118, 118, 128, 0.65);
    background-clip: padding-box;
    border: 2px solid transparent;
}
QScrollBar::handle:horizontal:pressed {
    background: rgba(118, 118, 128, 0.85);
    background-clip: padding-box;
    border: 2px solid transparent;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* ══════════════════════════════════════════
   工具提示
   ══════════════════════════════════════════ */
QToolTip {
    background: #2A2A31;
    color: #F0F0F4;
    border: 1px solid #3A3A42;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
    font-weight: 500;
    opacity: 240;
}

/* ══════════════════════════════════════════
   滚动区域 / 栈
   ══════════════════════════════════════════ */
QScrollArea {
    background: transparent;
    border: none;
}
QScrollArea > QWidget > QWidget {
    background: transparent;
}
QStackedWidget {
    background: transparent;
}

/* ══════════════════════════════════════════
   ROI 预览卡片
   ══════════════════════════════════════════ */
#roiCardThumb {
    background: #1A1A1F;
    border: 1px solid #2A2A31;
    border-radius: 10px;
}
#roiCardImage {
    background: #0F0F11;
    border: none;
    border-radius: 6px;
    color: #6E6E78;
}
#analysisCardThumb {
    background: #1A1A1F;
    border: 1px solid #2A2A31;
    border-radius: 10px;
}

/* 预览 / 结果标题栏 */
#previewTitleBar, #resultsTitleBar {
    background: #1F1F24;
    border-bottom: 1px solid #2E2E36;
    padding: 8px 12px;
}
#previewTitleLabel {
    color: #F0F0F4;
    font-size: 13px;
    font-weight: 600;
}
#previewInfoLabel, #previewStatus {
    color: rgba(240, 240, 244, 0.65);
    font-size: 12px;
    background: transparent;
}
#resultsBtnBar {
    background: #1A1A1F;
    border-top: 1px solid #2E2E36;
    padding: 8px 12px;
}

/* ══════════════════════════════════════════
   通用辅助文本类
   ══════════════════════════════════════════ */
QLabel[secondary="true"] {
    color: rgba(240, 240, 244, 0.58);
    font-size: 12px;
}
QLabel[role="hint"] {
    color: rgba(240, 240, 244, 0.48);
    font-size: 11px;
}
QLabel#hintText {
    color: rgba(240, 240, 244, 0.55);
    font-size: 11px;
    background: transparent;
}
QLabel#accentText {
    color: #64D2FF;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
}
QLabel#mutedText {
    color: rgba(240, 240, 244, 0.55);
    font-size: 12px;
    background: transparent;
}
QLabel#mutedSurface {
    background: #2A2A31;
    border-radius: 6px;
}
QLabel#successText {
    color: #30D158;
    font-size: 11px;
    background: transparent;
}
QLabel#warningText {
    color: #FF9F0A;
    font-size: 11px;
    background: transparent;
}
QLabel#errorText {
    color: #FF453A;
    font-size: 11px;
    background: transparent;
}

/* 文件列表：系统蓝选中（ROI 列表用 H&E 玫瑰） */
#fileList::item:selected,
QListWidget#fileList::item:selected {
    background: rgba(10, 132, 255, 0.22);
    color: #F0F0F4;
}
#fileList::item:selected:hover,
QListWidget#fileList::item:selected:hover {
    background: rgba(10, 132, 255, 0.32);
}
