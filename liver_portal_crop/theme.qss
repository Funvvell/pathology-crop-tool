/* ═══ 病理裁剪工具 v0.4 — 医疗级深色主题 ═══ */
/* 医疗级界面 · 青蓝强调 · 高对比度 · WCAG无障碍 */

/* ── 全局 ── */
QMainWindow, QWidget {
    background-color: #0f172a;
    color: #e2e8f0;
    font-family: "Microsoft YaHei UI", "Segoe UI", -apple-system, sans-serif;
    font-size: 13px;
}
QWidget:disabled {
    color: #475569;
}

/* ── 分割器 ── */
QSplitter::handle {
    background: #1e293b;
    width: 6px;
    margin: 1px 0;
}
QSplitter::handle:hover {
    background: #0891b2;
}

/* ── 菜单栏 ── */
QMenuBar {
    background: #0c1322;
    color: #e2e8f0;
    border-bottom: 1px solid #1e293b;
    padding: 2px 8px;
    font-size: 13px;
}
QMenuBar::item:selected { background: #1e293b; border-radius: 4px; }
QMenuBar::item:pressed { background: #0891b222; }

QMenu {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 28px;
    border-radius: 4px;
}
QMenu::item:selected {
    background: #0891b2;
    color: #fff;
}
QMenu::separator {
    height: 1px;
    background: #334155;
    margin: 4px 8px;
}

/* ── 顶部工具栏 ── */
#topToolbar {
    background: #0c1322;
    border-bottom: 1px solid #1e293b;
    padding: 0 4px;
}

#topToolbar QLabel {
    color: #94a3b8;
    font-size: 11px;
    background: transparent;
    border: none;
    padding: 4px 4px;
    min-height: 22px;
    max-height: 26px;
}

#topToolbar QComboBox, #topToolbar QSpinBox {
    background: #1e293b;
    color: #e2e8f0;
    border: 1px solid #334155;
    border-radius: 5px;
    padding: 2px 20px 2px 8px;
    font-size: 12px;
    min-height: 22px;
    max-height: 26px;
    min-width: 60px;
}
#topToolbar QComboBox:hover, #topToolbar QSpinBox:hover {
    border-color: #0891b2;
}
#topToolbar QComboBox:focus, #topToolbar QSpinBox:focus {
    border-color: #0891b2;
    outline: none;
}
#topToolbar QComboBox::drop-down {
    background: transparent;
    border: none;
    width: 18px;
}
#topToolbar QComboBox::down-arrow {
    image: url(__THEME_DIR__/arrow_down.png);
    width: 14px;
    height: 14px;
}
#topToolbar QComboBox QAbstractItemView {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 4px;
    color: #e2e8f0;
    outline: none;
}
#topToolbar QComboBox QAbstractItemView::item {
    padding: 5px 10px;
    border-radius: 3px;
}
#topToolbar QComboBox QAbstractItemView::item:selected {
    background: #0891b233;
    color: #fff;
}

#topToolbar QSpinBox::up-button, #topToolbar QSpinBox::down-button {
    background: transparent;
    border: none;
    border-radius: 2px;
    width: 16px;
    height: 10px;
    right: 1px;
}
#topToolbar QSpinBox::up-button:hover { background: #334155; }
#topToolbar QSpinBox::down-button:hover { background: #334155; }
#topToolbar QSpinBox::up-arrow {
    image: url(__THEME_DIR__/arrow_up.png);
    width: 12px;
    height: 12px;
}
#topToolbar QSpinBox::down-arrow {
    image: url(__THEME_DIR__/arrow_down.png);
    width: 12px;
    height: 12px;
}

/* ── 状态标签 ── */
#statusLabel {
    color: #e2e8f0;
    font-size: 12px;
    font-weight: 500;
    background: #1e293b;
    border-radius: 5px;
    padding: 4px 10px;
    border: 1px solid #1e293b;
}

/* ── 预设相关 ── */
#presetCb {
    min-width: 90px;
    font-weight: 600;
}
#savePresetBtn {
    background: transparent;
    border: none;
    font-size: 14px;
    padding: 0 4px;
}
#savePresetBtn:hover {
    background: #334155;
    border-radius: 3px;
}

/* ── 文件列表 ── */
QListWidget {
    background: #0c1322;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 4px;
    outline: none;
    color: #e2e8f0;
    font-size: 12px;
}
QListWidget::item {
    padding: 7px 10px;
    border-radius: 4px;
    margin: 1px 0;
}
QListWidget::item:selected {
    background: #0891b233;
    color: #fff;
    border-left: 2px solid #0891b2;
}
QListWidget::item:hover:!selected {
    background: #1e293b;
}

/* ── 普通按钮 ── */
QPushButton {
    background: #1e293b;
    color: #e2e8f0;
    border: 1px solid #334155;
    border-radius: 5px;
    padding: 5px 14px;
    font-size: 12px;
    min-height: 24px;
    max-height: 28px;
}
QPushButton:hover {
    background: #334155;
    border-color: #0891b2;
}
QPushButton:pressed {
    background: #0891b2;
    color: #fff;
}
QPushButton:checked {
    background: #0891b233;
    border-color: #0891b2;
    color: #fff;
}
QPushButton:disabled {
    background: #0f172a;
    color: #475569;
    border-color: #1e293b;
}
QPushButton:focus {
    border: 2px solid #0891b2;
    outline: none;
}

/* ── ROI 绘制按钮 ── */
#roiBtn {
    padding: 4px 16px;
    font-weight: 600;
}
#roiBtn:checked {
    background: #0891b2;
    color: #fff;
    border-color: #0891b2;
}

/* ── 导出按钮 ── */
#exportBtn {
    background: #22c55e;
    color: #fff;
    border: none;
    font-weight: 600;
    padding: 5px 20px;
    border-radius: 5px;
    min-height: 26px;
}
#exportBtn:hover {
    background: #16a34a;
}
#exportBtn:pressed {
    background: #15803d;
}

/* ── 输出目录按钮 ── */
#dirBtn {
    background: transparent;
    border: 1px solid #334155;
    color: #94a3b8;
    padding: 5px 12px;
}
#dirBtn:hover {
    border-color: #0891b2;
    color: #e2e8f0;
}

/* ── 取消/中断按钮 ── */
#cancelBtn {
    background: #ef4444;
    border: none;
    color: #fff;
    font-size: 13px;
    font-weight: bold;
    border-radius: 4px;
    min-width: 24px;
    min-height: 24px;
}
#cancelBtn:hover {
    background: #dc2626;
}
#cancelBtn:pressed {
    background: #b91c1c;
}

/* ── 导航缩略图 ── */
#navWidget {
    background: #0c1322;
    border: 1px solid #334155;
    border-radius: 8px;
}

/* ── 右侧面板 ROI 编辑框 ── */
QGroupBox, QFormLayout QLabel {
    color: #94a3b8;
    font-size: 11px;
}
QFormLayout QSpinBox {
    background: #1e293b;
    color: #e2e8f0;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 12px;
    min-height: 22px;
    max-height: 26px;
    min-width: 80px;
}
QFormLayout QSpinBox:hover {
    border-color: #0891b2;
}
QFormLayout QSpinBox:focus {
    border-color: #0891b2;
    background: #1e293b;
}
QFormLayout QSpinBox:disabled {
    background: #0c1322;
    color: #475569;
    border-color: #1e293b;
}

/* ── 进度条 ── */
#exportProgress {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 4px;
    text-align: center;
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    min-height: 20px;
    max-height: 22px;
    min-width: 180px;
}
#exportProgress::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0891b2, stop:1 #22d3ee);
    border-radius: 3px;
}

QProgressDialog {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 20px;
    color: #e2e8f0;
}

/* ── 对话框 ── */
QDialog {
    background: #0f172a;
}
QDialog QLabel {
    color: #e2e8f0;
    font-size: 13px;
}

QMessageBox {
    background: #0f172a;
    color: #e2e8f0;
}
QMessageBox QLabel {
    color: #e2e8f0;
    font-size: 13px;
}
QMessageBox QPushButton {
    min-width: 80px;
    min-height: 28px;
}

/* ── 输入对话框 ── */
QInputDialog QLineEdit {
    background: #1e293b;
    color: #e2e8f0;
    border: 1px solid #334155;
    border-radius: 5px;
    padding: 6px 10px;
    font-size: 13px;
    min-height: 22px;
}
QInputDialog QLineEdit:focus {
    border-color: #0891b2;
}

/* ── 滚动条 ── */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    border: none;
}
QScrollBar::handle:vertical {
    background: #334155;
    border-radius: 4px;
    min-height: 30px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background: #0891b2;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    border: none;
}
QScrollBar::handle:horizontal {
    background: #334155;
    border-radius: 4px;
    min-width: 30px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover {
    background: #0891b2;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── 工具提示 ── */
QToolTip {
    background: #1e293b;
    color: #e2e8f0;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

/* ── 标签页 ── */
QTabWidget::pane {
    background: #0f172a;
    border: 1px solid #334155;
    border-radius: 6px;
}
QTabBar::tab {
    background: #0c1322;
    color: #94a3b8;
    border: 1px solid #334155;
    border-bottom: none;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    padding: 6px 16px;
    font-size: 12px;
    min-height: 24px;
}
QTabBar::tab:selected {
    background: #0f172a;
    color: #e2e8f0;
    border-bottom: 2px solid #0891b2;
}
QTabBar::tab:hover:!selected {
    background: #1e293b;
    color: #e2e8f0;
}

/* ── ROI 预览对话框 ── */
#previewExportBtn {
    background: #0891b2;
    color: #fff;
    border: none;
    font-weight: 600;
    padding: 5px 16px;
    border-radius: 5px;
    min-height: 26px;
}
#previewExportBtn:hover {
    background: #0e7490;
}
#previewExportBtn:pressed {
    background: #155e75;
}
#previewExportBtn:disabled {
    background: #1e293b;
    color: #475569;
}

QScrollArea {
    background: transparent;
    border: none;
}
