/* ═══════════════════════════════════════════════════════════
   病理裁剪工具 — Apple 风格浅色主题
   设计语言：macOS Big Sur+ Light Mode
   强调色：Apple Blue #007AFF
   ═══════════════════════════════════════════════════════════ */

/* ── 全局基础 ── */
QMainWindow, QWidget {
    background-color: #f5f5f7;
    color: #1d1d1f;
    font-family: -apple-system, "SF Pro Text", "SF Pro Display",
                 "Helvetica Neue", "Microsoft YaHei UI", "Segoe UI",
                 sans-serif;
    font-size: 13px;
    line-height: 1.4;
}
QWidget:disabled {
    color: #86868b;
}

/* ── 分割器 ── */
QSplitter::handle {
    background: #d2d2d7;
    width: 1px;
    margin: 0;
}
QSplitter::handle:hover {
    background: #007AFF;
}

/* ══════════════════════════════════════════
   菜单栏
   ══════════════════════════════════════════ */
QMenuBar {
    background: #f0f0f2;
    color: #1d1d1f;
    border-bottom: 1px solid #d2d2d7;
    padding: 2px 10px;
    font-size: 13px;
    font-weight: 500;
}
QMenuBar::item {
    padding: 4px 10px;
    border-radius: 5px;
    background: transparent;
}
QMenuBar::item:selected {
    background: rgba(118, 118, 128, 0.20);
}
QMenuBar::item:pressed {
    background: rgba(0, 122, 255, 0.15);
}

QMenu {
    background: #ffffff;
    border: 1px solid #d2d2d7;
    border-radius: 10px;
    padding: 5px;
}
QMenu::item {
    padding: 6px 32px 6px 16px;
    border-radius: 5px;
    color: #1d1d1f;
}
QMenu::item:selected {
    background: #007AFF;
    color: #ffffff;
}
QMenu::separator {
    height: 1px;
    background: #d2d2d7;
    margin: 4px 12px;
}

/* ══════════════════════════════════════════
   顶部工具栏
   ══════════════════════════════════════════ */
#topToolbar {
    background: #f0f0f2;
    border-bottom: 1px solid #d2d2d7;
    padding: 0 8px;
}

#topToolbar QLabel {
    color: #86868b;
    font-size: 11px;
    font-weight: 500;
    background: transparent;
    border: none;
    padding: 0 3px;
    min-height: 24px;
    max-height: 28px;
}

/* 工具栏下拉框 & 数字输入 */
#topToolbar QComboBox,
#topToolbar QSpinBox {
    background: #ffffff;
    color: #1d1d1f;
    border: 1px solid #d2d2d7;
    border-radius: 5px;
    padding: 1px 20px 1px 6px;
    font-size: 12px;
    font-weight: 500;
    min-height: 20px;
    max-height: 24px;
    min-width: 48px;
}
#topToolbar QComboBox:hover,
#topToolbar QSpinBox:hover {
    border-color: #86868b;
}
#topToolbar QComboBox:focus,
#topToolbar QSpinBox:focus {
    border-color: #007AFF;
    outline: none;
}

/* 下拉箭头 */
#topToolbar QComboBox::drop-down {
    background: transparent;
    border: none;
    width: 18px;
}
#topToolbar QComboBox::down-arrow {
    image: url(__THEME_DIR__/arrow_down.png);
    width: 12px;
    height: 12px;
}

/* 下拉列表 */
#topToolbar QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #d2d2d7;
    border-radius: 8px;
    padding: 4px;
    color: #1d1d1f;
    outline: none;
    selection-background-color: #007AFF;
}
#topToolbar QComboBox QAbstractItemView::item {
    padding: 5px 12px;
    border-radius: 4px;
    min-height: 24px;
}
#topToolbar QComboBox QAbstractItemView::item:selected {
    background: #007AFF;
    color: #ffffff;
}

/* SpinBox 上下箭头 */
#topToolbar QSpinBox::up-button,
#topToolbar QSpinBox::down-button {
    background: transparent;
    border: none;
    border-radius: 3px;
    width: 16px;
    height: 10px;
    right: 2px;
}
#topToolbar QSpinBox::up-button:hover {
    background: #e8e8ed;
}
#topToolbar QSpinBox::down-button:hover {
    background: #e8e8ed;
}
#topToolbar QSpinBox::up-arrow {
    image: url(__THEME_DIR__/arrow_up.png);
    width: 10px;
    height: 10px;
}
#topToolbar QSpinBox::down-arrow {
    image: url(__THEME_DIR__/arrow_down.png);
    width: 10px;
    height: 10px;
}

/* 工具栏滑块 */
#topToolbar QSlider::groove:horizontal {
    background: #d2d2d7;
    height: 4px;
    border-radius: 2px;
}
#topToolbar QSlider::handle:horizontal {
    background: #ffffff;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
    border: 0.5px solid rgba(0, 0, 0, 0.12);
}
#topToolbar QSlider::handle:horizontal:hover {
    background: #f5f5f7;
}
#topToolbar QSlider::sub-page:horizontal {
    background: #007AFF;
    border-radius: 2px;
}

/* ══════════════════════════════════════════
   状态标签
   ══════════════════════════════════════════ */
#statusLabel {
    color: #1d1d1f;
    font-size: 12px;
    font-weight: 500;
    background: #e8e8ed;
    border-radius: 6px;
    padding: 4px 12px;
    border: 1px solid #d2d2d7;
}

/* ══════════════════════════════════════════
   预设下拉框
   ══════════════════════════════════════════ */
#presetCb {
    min-width: 90px;
    font-weight: 600;
}
#savePresetBtn {
    background: #ffffff;
    border: 1px solid #d2d2d7;
    border-radius: 5px;
    font-size: 11px;
    font-weight: 500;
    padding: 2px 8px;
    color: #1d1d1f;
    min-height: 20px;
    max-height: 24px;
}
#savePresetBtn:hover {
    background: #f0f0f2;
    border-color: #86868b;
    color: #1d1d1f;
}

/* ══════════════════════════════════════════
   通用按钮
   ══════════════════════════════════════════ */
QPushButton {
    background: #ffffff;
    color: #1d1d1f;
    border: 1px solid #d2d2d7;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 500;
    min-height: 20px;
    max-height: 24px;
}
QPushButton:hover {
    background: #f0f0f2;
    border-color: #86868b;
}
QPushButton:pressed {
    background: #e8e8ed;
}
QPushButton:checked {
    background: rgba(0, 122, 255, 0.10);
    border-color: #007AFF;
    color: #007AFF;
}
QPushButton:disabled {
    background: #f5f5f7;
    color: #86868b;
    border-color: #d2d2d7;
}
QPushButton:focus {
    border: 2px solid #007AFF;
    outline: none;
}

/* ── ROI 绘制按钮（强调色） ── */
#roiBtn {
    padding: 3px 12px;
    font-weight: 600;
    background: rgba(0, 122, 255, 0.08);
    border-color: #007AFF;
    color: #007AFF;
}
#roiBtn:hover {
    background: rgba(0, 122, 255, 0.15);
    border-color: #0066d6;
}
#roiBtn:checked {
    background: #007AFF;
    color: #ffffff;
    border-color: #007AFF;
}
#roiBtn:checked:hover {
    background: #0066d6;
}

/* ── 主要操作按钮（强调色） ── */
#primaryBtn {
    background: #007AFF;
    color: #ffffff;
    border: none;
    font-weight: 600;
    padding: 3px 14px;
    border-radius: 6px;
}
#primaryBtn:hover {
    background: #0066d6;
}
#primaryBtn:pressed {
    background: #0055b3;
}
#primaryBtn:disabled {
    background: #e8e8ed;
    color: #aeaeb2;
}

/* ── 导出按钮（成功色） ── */
#exportBtn {
    background: #34C759;
    color: #ffffff;
    border: none;
    font-weight: 600;
    padding: 3px 14px;
    border-radius: 6px;
    min-height: 22px;
}
#exportBtn:hover {
    background: #2db84e;
}
#exportBtn:pressed {
    background: #248a3d;
}
#exportBtn:disabled {
    background: #e8e8ed;
    color: #86868b;
}

/* ── 输出目录按钮（次要） ── */
#dirBtn {
    background: transparent;
    border: 1px solid #d2d2d7;
    color: #86868b;
    padding: 3px 10px;
    font-weight: 500;
}
#dirBtn:hover {
    border-color: #007AFF;
    color: #1d1d1f;
    background: rgba(0, 122, 255, 0.04);
}

/* ── 取消/中断按钮（危险色） ── */
#cancelBtn {
    background: #FF3B30;
    border: none;
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    border-radius: 6px;
    min-width: 24px;
    min-height: 24px;
    max-width: 24px;
    max-height: 24px;
    padding: 0;
}
#cancelBtn:hover {
    background: #ff6259;
}
#cancelBtn:pressed {
    background: #d70015;
}

/* ── 危险按钮 ── */
#dangerBtn {
    background: rgba(255, 59, 48, 0.08);
    color: #FF3B30;
    border: 1px solid rgba(255, 59, 48, 0.20);
    font-weight: 500;
}
#dangerBtn:hover {
    background: #FF3B30;
    color: #ffffff;
    border-color: #FF3B30;
}
#dangerBtn:pressed {
    background: #d70015;
    border-color: #d70015;
}

/* ── 窗口关闭按钮（标题栏） ── */
#previewCloseBtn {
    background: transparent;
    color: #86868b;
    border: none;
    border-radius: 14px;
    font-size: 14px;
    font-weight: 500;
    padding: 0;
    min-width: 28px;
    min-height: 28px;
    max-width: 28px;
    max-height: 28px;
}
#previewCloseBtn:hover {
    background: rgba(0, 0, 0, 0.06);
    color: #1d1d1f;
}
#previewCloseBtn:pressed {
    background: rgba(0, 0, 0, 0.10);
}

/* ── 预览导出按钮 ── */
#previewExportBtn {
    background: #007AFF;
    color: #ffffff;
    border: none;
    font-weight: 600;
    padding: 3px 12px;
    border-radius: 6px;
    min-height: 22px;
}
#previewExportBtn:hover {
    background: #0066d6;
}
#previewExportBtn:pressed {
    background: #004ea2;
}
#previewExportBtn:disabled {
    background: #e8e8ed;
    color: #86868b;
}

/* ══════════════════════════════════════════
   文件 & ROI 列表
   ══════════════════════════════════════════ */
QListWidget {
    background: #ffffff;
    border: 1px solid #d2d2d7;
    border-radius: 10px;
    padding: 4px;
    outline: none;
    color: #1d1d1f;
    font-size: 12px;
}
QListWidget::item {
    padding: 8px 12px;
    border-radius: 6px;
    margin: 1px 0;
}
QListWidget::item:selected {
    background: rgba(0, 122, 255, 0.12);
    color: #007AFF;
}
QListWidget::item:hover:!selected {
    background: #f5f5f7;
}

/* ══════════════════════════════════════════
   区块标题
   ══════════════════════════════════════════ */
#sectionHeader {
    color: #86868b;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 8px 0 2px 2px;
    background: transparent;
    border: none;
}

/* ══════════════════════════════════════════
   导航缩略图
   ══════════════════════════════════════════ */
#navWidget {
    background: #ffffff;
    border: 1px solid #d2d2d7;
    border-radius: 10px;
}

/* ══════════════════════════════════════════
   分析工具组
   ══════════════════════════════════════════ */
#analysisGroup {
    background: rgba(118, 118, 128, 0.06);
    border: 1px solid #d2d2d7;
    border-radius: 10px;
    padding: 8px;
}

/* ══════════════════════════════════════════
   右侧面板 ROI 表单
   ══════════════════════════════════════════ */
QGroupBox {
    color: #86868b;
    font-size: 11px;
    font-weight: 600;
}
QFormLayout QLabel {
    color: #86868b;
    font-size: 12px;
    font-weight: 500;
}
QFormLayout QSpinBox {
    background: #ffffff;
    color: #1d1d1f;
    border: 1px solid #d2d2d7;
    border-radius: 5px;
    padding: 2px 6px;
    font-size: 12px;
    font-weight: 500;
    min-height: 20px;
    max-height: 24px;
    min-width: 70px;
}
QFormLayout QSpinBox:hover {
    border-color: #86868b;
}
QFormLayout QSpinBox:focus {
    border-color: #007AFF;
    background: #ffffff;
}
QFormLayout QSpinBox:disabled {
    background: #f5f5f7;
    color: #86868b;
    border-color: #d2d2d7;
}
QFormLayout QSpinBox::up-button,
QFormLayout QSpinBox::down-button {
    background: transparent;
    border: none;
    border-radius: 3px;
    width: 16px;
    height: 10px;
    right: 2px;
}
QFormLayout QSpinBox::up-button:hover { background: #e8e8ed; }
QFormLayout QSpinBox::down-button:hover { background: #e8e8ed; }
QFormLayout QSpinBox::up-arrow {
    image: url(__THEME_DIR__/arrow_up.png);
    width: 10px;
    height: 10px;
}
QFormLayout QSpinBox::down-arrow {
    image: url(__THEME_DIR__/arrow_down.png);
    width: 10px;
    height: 10px;
}

/* ══════════════════════════════════════════
   进度条
   ══════════════════════════════════════════ */
#exportProgress {
    background: #e8e8ed;
    border: 1px solid #d2d2d7;
    border-radius: 5px;
    text-align: center;
    color: #1d1d1f;
    font-size: 10px;
    font-weight: 600;
    min-height: 18px;
    max-height: 20px;
    min-width: 180px;
}
#exportProgress::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #007AFF, stop:1 #64D2FF);
    border-radius: 4px;
}

QProgressDialog {
    background: #ffffff;
    border: 1px solid #d2d2d7;
    border-radius: 14px;
    padding: 24px;
    color: #1d1d1f;
}

/* ══════════════════════════════════════════
   对话框
   ══════════════════════════════════════════ */
QDialog {
    background: #ffffff;
}
QDialog QLabel {
    color: #1d1d1f;
    font-size: 13px;
}
QDialog QLineEdit {
    background: #ffffff;
    color: #1d1d1f;
    border: 1px solid #d2d2d7;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 12px;
    min-height: 22px;
}
QDialog QLineEdit:focus {
    border-color: #007AFF;
}
QDialog QPushButton {
    min-width: 72px;
    min-height: 24px;
}

QMessageBox {
    background: #ffffff;
    color: #1d1d1f;
}
QMessageBox QLabel {
    color: #1d1d1f;
    font-size: 13px;
    line-height: 1.5;
}
QMessageBox QPushButton {
    min-width: 80px;
    min-height: 24px;
}

/* ── 输入对话框 ── */
QInputDialog QLineEdit {
    background: #ffffff;
    color: #1d1d1f;
    border: 1px solid #d2d2d7;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
    min-height: 22px;
}
QInputDialog QLineEdit:focus {
    border-color: #007AFF;
}

/* ══════════════════════════════════════════
   滚动条
   ══════════════════════════════════════════ */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    border: none;
    margin: 2px 0;
}
QScrollBar::handle:vertical {
    background: #c7c7cc;
    border-radius: 4px;
    min-height: 32px;
    margin: 1px;
}
QScrollBar::handle:vertical:hover {
    background: #8e8e93;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    border: none;
    margin: 0 2px;
}
QScrollBar::handle:horizontal {
    background: #c7c7cc;
    border-radius: 4px;
    min-width: 32px;
    margin: 1px;
}
QScrollBar::handle:horizontal:hover {
    background: #8e8e93;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* ══════════════════════════════════════════
   工具提示
   ══════════════════════════════════════════ */
QToolTip {
    background: #1d1d1f;
    color: #f5f5f7;
    border: none;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: 500;
}

/* ══════════════════════════════════════════
   标签页
   ══════════════════════════════════════════ */
QTabWidget::pane {
    background: #ffffff;
    border: 1px solid #d2d2d7;
    border-radius: 10px;
    top: -1px;
}
QTabBar::tab {
    background: #f0f0f2;
    color: #86868b;
    border: 1px solid #d2d2d7;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 7px 18px;
    font-size: 12px;
    font-weight: 500;
    min-height: 26px;
}
QTabBar::tab:selected {
    background: #ffffff;
    color: #1d1d1f;
    border-bottom: 2px solid #007AFF;
}
QTabBar::tab:hover:!selected {
    background: #e8e8ed;
    color: #1d1d1f;
}

/* ══════════════════════════════════════════
   滚动区域
   ══════════════════════════════════════════ */
QScrollArea {
    background: transparent;
    border: none;
}

/* ══════════════════════════════════════════
   ROI 预览卡片
   ══════════════════════════════════════════ */
#roiCardThumb {
    background: #ffffff;
    border: 1px solid #d2d2d7;
    border-radius: 8px;
}
#roiCardImage {
    background: #f5f5f7;
    border: none;
    border-radius: 6px;
}

/* ══════════════════════════════════════════
   通用滑块
   ══════════════════════════════════════════ */
QSlider::groove:horizontal {
    background: #d2d2d7;
    height: 4px;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background: #ffffff;
    width: 20px;
    height: 20px;
    margin: -8px 0;
    border-radius: 10px;
    border: 0.5px solid rgba(0, 0, 0, 0.12);
}
QSlider::handle:horizontal:hover {
    background: #f5f5f7;
}
QSlider::sub-page:horizontal {
    background: #007AFF;
    border-radius: 2px;
}
QSlider::add-page:horizontal {
    background: #d2d2d7;
    border-radius: 2px;
}

/* ══════════════════════════════════════════
   复选框
   ══════════════════════════════════════════ */
QCheckBox {
    spacing: 8px;
    color: #1d1d1f;
    font-size: 13px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1.5px solid #c7c7cc;
    background: #ffffff;
}
QCheckBox::indicator:hover {
    border-color: #007AFF;
}
QCheckBox::indicator:checked {
    background: #007AFF;
    border-color: #007AFF;
}

/* ══════════════════════════════════════════
   通用下拉框（对话框内）
   ══════════════════════════════════════════ */
QComboBox {
    background: #ffffff;
    color: #1d1d1f;
    border: 1px solid #d2d2d7;
    border-radius: 6px;
    padding: 3px 20px 3px 8px;
    font-size: 12px;
    min-height: 22px;
}
QComboBox:hover {
    border-color: #86868b;
}
QComboBox:focus {
    border-color: #007AFF;
    outline: none;
}
QComboBox::drop-down {
    background: transparent;
    border: none;
    width: 20px;
}
QComboBox::down-arrow {
    image: url(__THEME_DIR__/arrow_down.png);
    width: 12px;
    height: 12px;
}
QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #d2d2d7;
    border-radius: 8px;
    padding: 4px;
    color: #1d1d1f;
    outline: none;
    selection-background-color: #007AFF;
}
QComboBox QAbstractItemView::item {
    padding: 6px 12px;
    border-radius: 4px;
    min-height: 26px;
}
QComboBox QAbstractItemView::item:selected {
    background: #007AFF;
    color: #ffffff;
}

/* ══════════════════════════════════════════
   通用 SpinBox（对话框内）
   ══════════════════════════════════════════ */
QSpinBox {
    background: #ffffff;
    color: #1d1d1f;
    border: 1px solid #d2d2d7;
    border-radius: 6px;
    padding: 2px 6px;
    font-size: 12px;
    min-height: 22px;
}
QSpinBox:hover {
    border-color: #86868b;
}
QSpinBox:focus {
    border-color: #007AFF;
}
QSpinBox:disabled {
    background: #f5f5f7;
    color: #86868b;
}
QSpinBox::up-button,
QSpinBox::down-button {
    background: transparent;
    border: none;
    border-radius: 3px;
    width: 18px;
    height: 12px;
    right: 2px;
}
QSpinBox::up-button:hover { background: #e8e8ed; }
QSpinBox::down-button:hover { background: #e8e8ed; }
QSpinBox::up-arrow {
    image: url(__THEME_DIR__/arrow_up.png);
    width: 10px;
    height: 10px;
}
QSpinBox::down-arrow {
    image: url(__THEME_DIR__/arrow_down.png);
    width: 10px;
    height: 10px;
}

/* ══════════════════════════════════════════
   通用行输入
   ══════════════════════════════════════════ */
QLineEdit {
    background: #ffffff;
    color: #1d1d1f;
    border: 1px solid #d2d2d7;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 12px;
    min-height: 22px;
}
QLineEdit:focus {
    border-color: #007AFF;
}
QLineEdit:disabled {
    background: #f5f5f7;
    color: #86868b;
}
