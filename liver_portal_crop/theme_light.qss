/* ═══ 病理裁剪工具 — Glassmorphism 浅色主题 ═══ */
/* 半透明白底 · 天蓝强调 · 柔光边框 · 10px 圆角 */

/* ── 全局 ── */
QMainWindow, QWidget {
    background-color: #f8fafc;
    color: #0f172a;
    font-family: "Microsoft YaHei UI", "Segoe UI", -apple-system, sans-serif;
    font-size: 13px;
}
QWidget:disabled {
    color: #94a3b8;
}

/* ── 分割器 ── */
QSplitter::handle {
    background: rgba(203,213,225,0.5);
    width: 6px;
    margin: 1px 0;
}
QSplitter::handle:hover {
    background: #38bdf8;
}

/* ── 菜单栏 ── */
QMenuBar {
    background: rgba(241,245,249,0.9);
    color: #0f172a;
    border-bottom: 1px solid rgba(203,213,225,0.5);
    padding: 2px 8px;
    font-size: 13px;
}
QMenuBar::item:selected { background: rgba(56,189,248,0.12); border-radius: 6px; }
QMenuBar::item:pressed { background: rgba(56,189,248,0.2); }

QMenu {
    background: rgba(255,255,255,0.95);
    border: 1px solid rgba(203,213,225,0.6);
    border-radius: 10px;
    padding: 6px;
}
QMenu::item {
    padding: 7px 28px;
    border-radius: 6px;
}
QMenu::item:selected {
    background: rgba(56,189,248,0.15);
    color: #0284c7;
}
QMenu::separator {
    height: 1px;
    background: rgba(203,213,225,0.5);
    margin: 4px 8px;
}

/* ── 顶部工具栏 ── */
#topToolbar {
    background: rgba(241,245,249,0.85);
    border-bottom: 1px solid rgba(203,213,225,0.5);
    padding: 0 4px;
}

#topToolbar QLabel {
    color: #64748b;
    font-size: 11px;
    background: transparent;
    border: none;
    padding: 4px 4px;
    min-height: 22px;
    max-height: 26px;
}

#topToolbar QComboBox, #topToolbar QSpinBox {
    background: rgba(255,255,255,0.7);
    color: #0f172a;
    border: 1px solid rgba(203,213,225,0.6);
    border-radius: 8px;
    padding: 2px 20px 2px 8px;
    font-size: 12px;
    min-height: 22px;
    max-height: 26px;
    min-width: 60px;
}
#topToolbar QComboBox:hover, #topToolbar QSpinBox:hover {
    border-color: rgba(56,189,248,0.5);
}
#topToolbar QComboBox:focus, #topToolbar QSpinBox:focus {
    border-color: #38bdf8;
    outline: none;
}
#topToolbar QComboBox::drop-down {
    background: transparent;
    border: none;
    width: 18px;
}
#topToolbar QComboBox::down-arrow {
    image: url(__THEME_DIR__/arrow_down.png);
    width: 14px;
    height: 14px;
}
#topToolbar QComboBox QAbstractItemView {
    background: rgba(255,255,255,0.95);
    border: 1px solid rgba(203,213,225,0.6);
    border-radius: 8px;
    padding: 4px;
    color: #0f172a;
    outline: none;
}
#topToolbar QComboBox QAbstractItemView::item {
    padding: 5px 10px;
    border-radius: 6px;
}
#topToolbar QComboBox QAbstractItemView::item:selected {
    background: rgba(56,189,248,0.12);
    color: #0284c7;
}

#topToolbar QSpinBox::up-button, #topToolbar QSpinBox::down-button {
    background: transparent;
    border: none;
    border-radius: 2px;
    width: 16px;
    height: 10px;
    right: 1px;
}
#topToolbar QSpinBox::up-button:hover { background: rgba(56,189,248,0.12); }
#topToolbar QSpinBox::down-button:hover { background: rgba(56,189,248,0.12); }
#topToolbar QSpinBox::up-arrow {
    image: url(__THEME_DIR__/arrow_up.png);
    width: 12px;
    height: 12px;
}
#topToolbar QSpinBox::down-arrow {
    image: url(__THEME_DIR__/arrow_down.png);
    width: 12px;
    height: 12px;
}

/* ── 状态标签 ── */
#statusLabel {
    color: #0f172a;
    font-size: 12px;
    font-weight: 500;
    background: rgba(226,232,240,0.6);
    border-radius: 8px;
    padding: 4px 10px;
    border: 1px solid rgba(203,213,225,0.5);
}

/* ── 预设相关 ── */
#presetCb {
    min-width: 90px;
    font-weight: 600;
}
#savePresetBtn {
    background: transparent;
    border: none;
    font-size: 14px;
    padding: 0 4px;
}
#savePresetBtn:hover {
    background: rgba(56,189,248,0.12);
    border-radius: 6px;
}

/* ── 文件列表 ── */
QListWidget {
    background: rgba(255,255,255,0.7);
    border: 1px solid rgba(203,213,225,0.5);
    border-radius: 10px;
    padding: 4px;
    outline: none;
    color: #0f172a;
    font-size: 12px;
}
QListWidget::item {
    padding: 7px 10px;
    border-radius: 6px;
    margin: 1px 0;
}
QListWidget::item:selected {
    background: rgba(56,189,248,0.12);
    color: #0284c7;
    border-left: 2px solid #38bdf8;
}
QListWidget::item:hover:!selected {
    background: rgba(241,245,249,0.8);
}

/* ── 普通按钮 ── */
QPushButton {
    background: rgba(255,255,255,0.7);
    color: #0f172a;
    border: 1px solid rgba(203,213,225,0.6);
    border-radius: 8px;
    padding: 5px 14px;
    font-size: 12px;
    min-height: 24px;
    max-height: 28px;
}
QPushButton:hover {
    background: rgba(56,189,248,0.1);
    border-color: rgba(56,189,248,0.3);
    color: #0284c7;
}
QPushButton:pressed {
    background: rgba(56,189,248,0.2);
    color: #0284c7;
}
QPushButton:checked {
    background: rgba(56,189,248,0.15);
    border-color: #38bdf8;
    color: #0284c7;
}
QPushButton:disabled {
    background: rgba(248,250,252,0.5);
    color: #94a3b8;
    border-color: rgba(203,213,225,0.3);
}
QPushButton:focus {
    border: 1px solid #38bdf8;
    outline: none;
}

/* ── ROI 绘制按钮 ── */
#roiBtn {
    padding: 4px 16px;
    font-weight: 600;
}
#roiBtn:checked {
    background: #38bdf8;
    color: #fff;
    border-color: #38bdf8;
}

/* ── 导出按钮 ── */
#exportBtn {
    background: #34d399;
    color: #fff;
    border: none;
    font-weight: 600;
    padding: 5px 20px;
    border-radius: 8px;
    min-height: 26px;
}
#exportBtn:hover {
    background: #6ee7b7;
}
#exportBtn:pressed {
    background: #10b981;
}

/* ── 预览导出按钮 ── */
#previewExportBtn {
    background: #38bdf8;
    color: #fff;
    border: none;
    font-weight: 600;
    padding: 5px 16px;
    border-radius: 8px;
    min-height: 26px;
}
#previewExportBtn:hover {
    background: #7dd3fc;
}
#previewExportBtn:pressed {
    background: #0ea5e9;
}
#previewExportBtn:disabled {
    background: rgba(226,232,240,0.5);
    color: #94a3b8;
}

/* ── 输出目录按钮 ── */
#dirBtn {
    background: transparent;
    border: 1px solid rgba(203,213,225,0.6);
    color: #64748b;
    padding: 5px 12px;
}
#dirBtn:hover {
    border-color: rgba(56,189,248,0.5);
    color: #0f172a;
}

/* ── 取消/中断按钮 ── */
#cancelBtn {
    background: #f87171;
    border: none;
    color: #fff;
    font-size: 13px;
    font-weight: bold;
    border-radius: 6px;
    min-width: 24px;
    min-height: 24px;
}
#cancelBtn:hover {
    background: #fca5a5;
}
#cancelBtn:pressed {
    background: #ef4444;
}

/* ── 导航缩略图 ── */
#navWidget {
    background: rgba(255,255,255,0.7);
    border: 1px solid rgba(203,213,225,0.5);
    border-radius: 10px;
}

/* ── 右侧面板 ROI 编辑框 ── */
QGroupBox, QFormLayout QLabel {
    color: #64748b;
    font-size: 11px;
}
QFormLayout QSpinBox {
    background: rgba(255,255,255,0.7);
    color: #0f172a;
    border: 1px solid rgba(203,213,225,0.6);
    border-radius: 8px;
    padding: 2px 6px;
    font-size: 12px;
    min-height: 22px;
    max-height: 26px;
    min-width: 80px;
}
QFormLayout QSpinBox:hover {
    border-color: rgba(56,189,248,0.5);
}
QFormLayout QSpinBox:focus {
    border-color: #38bdf8;
    background: rgba(255,255,255,0.9);
}
QFormLayout QSpinBox:disabled {
    background: rgba(248,250,252,0.5);
    color: #94a3b8;
    border-color: rgba(203,213,225,0.3);
}

/* ── 进度条 ── */
#exportProgress {
    background: rgba(226,232,240,0.6);
    border: 1px solid rgba(203,213,225,0.5);
    border-radius: 6px;
    text-align: center;
    color: #0f172a;
    font-size: 11px;
    font-weight: 600;
    min-height: 20px;
    max-height: 22px;
    min-width: 180px;
}
#exportProgress::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #38bdf8, stop:1 #7dd3fc);
    border-radius: 5px;
}

QProgressDialog {
    background: rgba(255,255,255,0.95);
    border: 1px solid rgba(203,213,225,0.6);
    border-radius: 10px;
    padding: 20px;
    color: #0f172a;
}

/* ── 对话框 ── */
QDialog {
    background: rgba(255,255,255,0.95);
}
QDialog QLabel {
    color: #0f172a;
    font-size: 13px;
}

QMessageBox {
    background: rgba(255,255,255,0.95);
    color: #0f172a;
}
QMessageBox QLabel {
    color: #0f172a;
    font-size: 13px;
}
QMessageBox QPushButton {
    min-width: 80px;
    min-height: 28px;
}

/* ── 输入对话框 ── */
QInputDialog QLineEdit {
    background: rgba(255,255,255,0.7);
    color: #0f172a;
    border: 1px solid rgba(203,213,225,0.6);
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 13px;
    min-height: 22px;
}
QInputDialog QLineEdit:focus {
    border-color: #38bdf8;
}

/* ── 滚动条 ── */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    border: none;
}
QScrollBar::handle:vertical {
    background: rgba(203,213,225,0.5);
    border-radius: 3px;
    min-height: 30px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(56,189,248,0.5);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    border: none;
}
QScrollBar::handle:horizontal {
    background: rgba(203,213,225,0.5);
    border-radius: 3px;
    min-width: 30px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover {
    background: rgba(56,189,248,0.5);
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ── 工具提示 ── */
QToolTip {
    background: rgba(255,255,255,0.95);
    color: #0f172a;
    border: 1px solid rgba(203,213,225,0.6);
    border-radius: 8px;
    padding: 5px 10px;
    font-size: 12px;
}

/* ── 标签页 ── */
QTabWidget::pane {
    background: rgba(255,255,255,0.85);
    border: 1px solid rgba(203,213,225,0.5);
    border-radius: 10px;
}
QTabBar::tab {
    background: rgba(241,245,249,0.7);
    color: #64748b;
    border: 1px solid rgba(203,213,225,0.4);
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 6px 16px;
    font-size: 12px;
    min-height: 24px;
}
QTabBar::tab:selected {
    background: rgba(255,255,255,0.95);
    color: #0f172a;
    border-bottom: 2px solid #38bdf8;
}
QTabBar::tab:hover:!selected {
    background: rgba(226,232,240,0.6);
    color: #0f172a;
}

/* ── ROI 预览对话框 ── */
QScrollArea {
    background: transparent;
    border: none;
}
